/* Ajet luxury aviation design system */
:root{
  --bg:#090a0b; --bg2:#0e0f10; --panel:#131414; --panel2:#191a19;
  --ivory:#f1eee7; --muted:#a09d96; --faint:#686660;
  --gold:#b9a17a; --gold2:#d5c29e; --gold-d:#8c7858;
  --line:rgba(241,238,231,.14); --line2:rgba(241,238,231,.075);
  --ease-lux:cubic-bezier(.16,1,.3,1);
  --serif:var(--font-serif),Georgia,serif; --sans:var(--font-sans),system-ui,sans-serif;
}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%;scroll-behavior:smooth;scroll-padding-top:5rem;overflow-x:clip}
body{margin:0;background:var(--bg);color:var(--ivory);font:400 1rem/1.75 var(--sans);-webkit-font-smoothing:antialiased;overflow-x:clip}
h1,h2,h3{font-family:var(--serif);font-weight:400;line-height:1.08;margin:0 0 .5em}
h1{font-size:clamp(2.6rem,6.2vw,4.8rem)} h2{font-size:clamp(1.9rem,3.6vw,2.9rem)} h3{font-size:1.35rem}
p{margin:0 0 1em} a{color:inherit;text-decoration:none} img{max-width:100%;display:block}
::selection{background:var(--gold);color:var(--bg)}
:focus-visible{outline:2px solid var(--gold);outline-offset:3px}
.wrap{max-width:1240px;margin:0 auto;padding:0 clamp(1.25rem,4vw,3rem)}
.wrap.sec{padding-left:clamp(1.25rem,4vw,3rem);padding-right:clamp(1.25rem,4vw,3rem)}
.narrow{max-width:760px}
.eyebrow{display:inline-flex;align-items:center;gap:.9rem;font:500 .66rem/1.4 var(--sans);letter-spacing:.3em;text-transform:uppercase;color:var(--gold2);margin-bottom:1.3rem}
.eyebrow::before{content:"";width:30px;height:1px;background:var(--gold)}
.lead{font-size:clamp(1.02rem,1.6vw,1.2rem);color:var(--muted);max-width:38rem}
.btn{position:relative;isolation:isolate;display:inline-flex;align-items:center;justify-content:center;gap:.8rem;overflow:hidden;background:var(--ivory);color:#11110f;border:1px solid var(--ivory);border-radius:0;padding:1.05rem 1.8rem;font:600 .68rem/1 var(--sans);letter-spacing:.19em;text-transform:uppercase;cursor:pointer;transition:color .45s var(--ease-lux),border-color .45s var(--ease-lux),transform .45s var(--ease-lux)}
.btn::before{content:"";position:absolute;z-index:-1;inset:0;background:var(--gold2);transform:translateY(102%);transition:transform .5s var(--ease-lux)}
.btn:hover{transform:translateY(-2px);border-color:var(--gold2);color:#15130f}
.btn:hover::before{transform:translateY(0)}
.btn.ghost{background:transparent;color:var(--ivory);border-color:var(--line);box-shadow:none}
.btn.ghost::before{background:rgba(213,194,158,.08)}
.btn.ghost:hover{border-color:var(--gold);color:var(--gold2)}
.btn.sm{padding:.62rem 1.2rem;font-size:.7rem}
.textlink{position:relative;color:var(--ivory);font:500 .68rem var(--sans);letter-spacing:.17em;text-transform:uppercase;display:inline-flex;align-items:center;gap:.7rem}
.textlink::after{content:"→";color:var(--gold2);transition:transform .4s var(--ease-lux)}
.textlink:hover::after{transform:translateX(8px)}
.top{position:fixed;inset:0 0 auto;z-index:60;display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:.9rem clamp(1.25rem,4vw,3rem);background:rgba(9,10,11,.94);backdrop-filter:blur(16px);border-bottom:1px solid var(--line2);transition:padding .55s var(--ease-lux),background .55s var(--ease-lux),border-color .55s var(--ease-lux),backdrop-filter .55s var(--ease-lux)}
.top.over-hero:not(.scrolled):not(.menu-open){background:transparent;border-color:transparent;backdrop-filter:none}
.top.scrolled{padding-top:.58rem;padding-bottom:.58rem;background:rgba(9,10,11,.78);backdrop-filter:blur(18px);border-color:var(--line2)}
.top.over-hero:not(.scrolled){animation:nav-enter .9s .2s both}
.brand{display:flex;align-items:center;gap:.8rem;font:500 1.5rem/1 var(--serif);letter-spacing:.035em;transition:transform .55s var(--ease-lux)}
.brand>span:last-child{display:flex;flex-direction:column;align-items:flex-start;position:relative;gap:.3rem}
.brand-mark{width:2.5rem;height:2.5rem;flex:none;position:relative;display:grid;place-items:center;border:1px solid rgba(201,181,142,.65);border-radius:50%;background:rgba(9,10,11,.12);transition:transform .55s var(--ease-lux)}
.brand-mark::before,.brand-mark::after{content:"";position:absolute;inset:4px;border:1px solid rgba(201,181,142,.42);border-radius:50%}
.brand-mark::after{inset:9px;border-color:rgba(201,181,142,.35)}
.brand-mark i{width:4px;height:4px;border-radius:50%;background:var(--gold2)}
.top.scrolled .brand{transform:scale(.94);transform-origin:left center}
.brand small{font:500 .5rem/1 var(--sans);letter-spacing:.29em;text-transform:uppercase;color:var(--muted)}
.site-nav{display:flex;align-items:center;gap:2rem}
.site-nav>a:not(.btn){font:500 .63rem var(--sans);letter-spacing:.16em;text-transform:uppercase;color:rgba(241,238,231,.76);position:relative;padding:.4rem 0;transition:color .35s}
.site-nav>a:not(.btn)::after{content:"";position:absolute;left:0;bottom:0;width:100%;height:1px;background:var(--gold2);transform:scaleX(0);transform-origin:right;transition:transform .45s var(--ease-lux)}
.site-nav>a:not(.btn):hover{color:var(--ivory)} .site-nav>a:not(.btn):hover::after{transform:scaleX(1);transform-origin:left}
.top.over-hero:not(.scrolled) .site-nav{animation:nav-enter .75s .38s both}
.top .site-nav .btn{min-width:10.6rem}
.top .site-nav .btn::after{content:"→";font-size:.95rem;transition:transform .4s var(--ease-lux)}
.top .site-nav .btn:hover::after{transform:translateX(5px)}
.menu-toggle{display:none}
.lang{display:inline-flex;border:1px solid var(--line);font:500 .64rem var(--sans);letter-spacing:.15em;padding:.38rem .65rem;color:var(--muted);transition:border-color .35s,color .35s}
.lang:hover{border-color:var(--gold);color:var(--ivory)}
.hero{position:relative;min-height:100svh;background:#050709;overflow:hidden}
.hero-intro{position:absolute;inset:0;z-index:3;display:flex;align-items:flex-start;justify-content:center;padding-top:clamp(10rem,21vh,14rem);padding-bottom:0;pointer-events:none}
.hero-copy{width:100%;max-width:1240px}
.hero-intro .eyebrow{margin-bottom:1rem}
.hero-intro .eyebrow,.hero-intro h1,.hero-intro .lead{pointer-events:auto}
.hero-intro .eyebrow{animation:hero-copy-enter .8s .15s both}
.hero-intro h1{max-width:14ch;font-size:clamp(3.5rem,8.3vw,7.8rem);letter-spacing:-.035em;line-height:.94;margin:0 0 1.15rem;clip-path:inset(0 0 100% 0);animation:hero-title-reveal 1.1s .2s var(--ease-lux) both}
.hero-intro .lead{max-width:37rem;margin:0;color:rgba(243,239,230,.78);font-size:clamp(1rem,1.45vw,1.2rem);animation:hero-copy-enter .9s .4s var(--ease-lux) both}
.hero-stage{position:relative;min-height:100svh;display:flex;align-items:flex-end;justify-content:center;overflow:hidden}
.hero .bgimg{position:absolute;inset:0}
.hero .bgimg img{width:100%;height:100%;object-fit:cover;object-position:center 48%;transform:scale(1.05);animation:hero-image-enter 2s 0s var(--ease-lux) both}
.hero .veil{position:absolute;inset:0;background:radial-gradient(ellipse at 56% 42%,transparent 30%,rgba(0,0,0,.22) 100%),linear-gradient(180deg,rgba(5,7,9,.12) 0%,rgba(5,7,9,.08) 48%,rgba(5,7,9,.76) 100%),linear-gradient(90deg,rgba(5,7,9,.66),rgba(5,7,9,.32) 46%,rgba(5,7,9,.04) 82%)}
.hero h1 em{font-style:italic;color:var(--gold2)}
.hero-stage-content{position:absolute;left:clamp(1.25rem,4vw,3rem);bottom:4.6rem;z-index:2;text-align:left;padding:1rem 0;animation:hero-copy-enter .85s .6s var(--ease-lux) both}
.hero-caption{font:500 .62rem var(--sans);letter-spacing:.29em;text-transform:uppercase;color:rgba(255,255,255,.8);margin:0 0 1.15rem}
.hero .cta{display:flex;justify-content:flex-start;gap:1rem;flex-wrap:wrap}
.hero .cta .btn{min-width:13rem;justify-content:center}
.hero .cta .btn span{font-size:1rem;transition:transform .4s var(--ease-lux)}
.hero .cta .btn:hover span{transform:translate(5px,0)}
.scroll-cue{position:absolute;left:50%;bottom:1.4rem;transform:translateX(-50%);display:flex;align-items:center;gap:.7rem;color:rgba(255,255,255,.74);font:600 .58rem var(--sans);letter-spacing:.2em;text-transform:uppercase;white-space:nowrap}
.scroll-cue span{width:1px;height:25px;background:linear-gradient(var(--gold2),transparent)}
@keyframes hero-copy-enter{from{opacity:0;transform:translate3d(0,26px,0)}to{opacity:1;transform:translate3d(0,0,0)}}
@keyframes hero-title-reveal{from{opacity:.7;clip-path:inset(0 0 100% 0);transform:translate3d(0,18px,0)}to{opacity:1;clip-path:inset(0 0 0 0);transform:translate3d(0,0,0)}}
@keyframes hero-image-enter{from{opacity:.6;transform:scale(1.05)}to{opacity:1;transform:scale(1)}}
@keyframes nav-enter{from{opacity:0;transform:translateY(-8px)}to{opacity:1;transform:translateY(0)}}
.stats{border-block:1px solid var(--line2);background:var(--bg2)}
.stats .wrap{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr))}
.stat{padding:2.3rem 1.4rem;text-align:center;border-left:1px solid var(--line2);transition:transform .8s var(--ease-lux),opacity .8s var(--ease-lux)}
.stat:first-child{border-left:0}
.stat b{display:block;font:400 clamp(2.3rem,4vw,3.2rem)/1 var(--serif);color:var(--ivory);letter-spacing:.01em}
.stat span{font:500 .61rem var(--sans);letter-spacing:.2em;text-transform:uppercase;color:var(--muted)}
.stat.rv.in b{animation:stat-value-in .8s var(--ease-lux) both}
@keyframes stat-value-in{from{opacity:0;transform:translateY(14px);clip-path:inset(0 0 65% 0)}to{opacity:1;transform:translateY(0);clip-path:inset(0)}}
.journey{position:relative;overflow:clip;padding:clamp(4rem,8vw,7rem) 0;background:linear-gradient(180deg,#0a0b0b,#101110 48%,#0a0b0b);border-bottom:1px solid var(--line2)}
.journey-heading{display:flex;justify-content:space-between;align-items:end;gap:2rem;margin-bottom:2rem}
.journey-heading .eyebrow{margin:0}
.journey-heading>p:last-child{max-width:28rem;margin:0;color:var(--muted);font-size:.9rem}
.journey-layout{display:grid;grid-template-columns:minmax(280px,.8fr) minmax(0,1.2fr);align-items:start;gap:clamp(2rem,6vw,6rem);max-width:1400px;margin:0 auto;padding:0 clamp(1.25rem,4vw,3rem)}
.journey-copy{min-width:0}
.journey-scene{min-height:76svh;display:flex;flex-direction:column;justify-content:center;padding:4rem 0;border-top:1px solid var(--line2);opacity:.48;transition:opacity .75s var(--ease-lux)}
.journey-scene:first-child{border-top-color:var(--line)}
.journey-scene[aria-current=step]{opacity:1}
.journey-label{display:flex;align-items:center;gap:.85rem;margin:0 0 1.3rem;color:var(--gold2);font:500 .61rem var(--sans);letter-spacing:.22em;text-transform:uppercase}
.journey-label span{color:var(--faint)}
.journey-scene h2{max-width:12ch;margin:0 0 1.1rem;font-size:clamp(2.6rem,5.2vw,5rem);letter-spacing:-.025em;line-height:.98}
.journey-body{max-width:28rem;margin:0;color:var(--muted);font-size:clamp(.95rem,1.2vw,1.05rem)}
.journey-scene--invitation .btn{align-self:flex-start;margin-top:1.8rem}
.journey-scene--invitation .btn span{font-size:1.05rem;transition:transform .45s var(--ease-lux)}
.journey-scene--invitation .btn:hover span{transform:translateX(6px)}
.journey-scene-image{display:none}
.journey-visual{position:sticky;top:13vh;grid-column:2;grid-row:1;height:min(76vh,760px);margin:5vh 0 15vh;overflow:hidden;background:#171817}
.journey-image-stack{position:absolute;inset:0}
.journey-image{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;filter:saturate(.68) brightness(.78);opacity:0;transform:scale(1.035);transition:opacity .9s var(--ease-lux),transform 1.5s var(--ease-lux)}
.journey-image.is-active{opacity:1;transform:scale(1)}
.journey-image-shade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.04),rgba(0,0,0,.14) 58%,rgba(0,0,0,.54)),linear-gradient(90deg,rgba(9,10,11,.12),transparent 45%);pointer-events:none}
.journey-image-caption{position:absolute;right:1.4rem;bottom:1.35rem;left:1.4rem;z-index:1;display:flex;justify-content:space-between;gap:1rem;color:rgba(241,238,231,.86);font:500 .58rem var(--sans);letter-spacing:.2em;text-transform:uppercase}
.journey-progress{position:absolute;bottom:0;left:0;height:2px;background:var(--gold2);transition:width .75s var(--ease-lux)}
.sec{padding:clamp(5.5rem,10vw,9rem) 0}
.sec.head{display:flex;justify-content:space-between;align-items:flex-end;gap:2rem;margin-bottom:3.2rem;flex-wrap:wrap}
.sec.head h2{max-width:22ch;margin-bottom:0} .sec.head p{max-width:34rem;color:var(--muted)}
.band{background:linear-gradient(180deg,#0d0e0f,#101110 52%,#0d0e0f);border-block:1px solid var(--line2)}
.steps{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:2.5rem;list-style:none;padding:0;margin:0;counter-reset:step}
.steps li{position:relative;padding-top:1.6rem;border-top:1px solid var(--line);transition:border-color .5s var(--ease-lux)}
.steps li:hover{border-color:var(--gold)}
.steps li::before{counter-increment:step;content:"0" counter(step);position:absolute;top:-1.35rem;left:0;font:400 2.6rem var(--serif);color:transparent;-webkit-text-stroke:1px rgba(185,161,122,.75);background:var(--bg);padding-right:1rem}
.band .steps li::before{background:var(--bg2)}
.steps strong{display:block;font:400 1.45rem var(--serif);margin:.4rem 0 .5rem}
.steps span{color:var(--muted);font-size:.95rem}
.fleet-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:2rem;clip-path:inset(-12px 0 -12px 0)}
.fleet-showcase{grid-template-columns:1fr;gap:2.2rem;margin-top:3rem}
.fleet-showcase .ac{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(260px,.7fr);align-items:stretch}
.fleet-showcase .ac:nth-child(even) .ph{grid-column:2;grid-row:1}
.fleet-showcase .ac:nth-child(even) .bd{grid-column:1;grid-row:1}
.ac{border:1px solid var(--line2);background:#101111;transition:transform .7s var(--ease-lux),border-color .55s var(--ease-lux)}
.ac:hover{transform:translateY(-5px);border-color:rgba(185,161,122,.48)}
.ac .ph{aspect-ratio:16/9;overflow:hidden;background:#171817}
.ac .ph img{width:100%;height:100%;object-fit:cover;transition:transform 1.1s var(--ease-lux),filter 1.1s var(--ease-lux);filter:saturate(.72) brightness(.91)}
.ac:hover .ph img{transform:scale(1.04);filter:saturate(.88) brightness(1)}
.ac .bd{padding:1.5rem 1.65rem 1.8rem}
.fleet-showcase .ac .ph{min-height:390px;height:100%;aspect-ratio:auto}
.fleet-showcase .ac .bd{display:flex;flex-direction:column;justify-content:center;padding:clamp(2rem,5vw,4.5rem)}
.fleet-showcase .ac h2{margin:.5rem 0 .8rem;font-size:clamp(2.4rem,4.5vw,4.4rem)}
.fleet-showcase .ac .specs{gap:1.4rem 2rem}
.fleet-page>div:first-of-type{max-width:52rem}
.destinations-page>div:first-of-type{max-width:52rem}
.destination-showcase{grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:1rem}
.ac h3{margin-bottom:.3rem}
.ac .tag{font:500 .59rem var(--sans);letter-spacing:.25em;text-transform:uppercase;color:var(--gold2)}
.specs{display:flex;flex-wrap:wrap;gap:1.6rem;margin:1.2rem 0 0;padding-top:1.2rem;border-top:1px solid var(--line2)}
.specs dt{font:500 .59rem var(--sans);letter-spacing:.16em;text-transform:uppercase;color:var(--faint)}
.specs dd{margin:0;font:400 1.2rem var(--serif);color:var(--ivory)}
.ac p{color:var(--muted);font-size:.95rem;margin:.6rem 0 0}
.split{display:grid;grid-template-columns:1fr 1fr;gap:clamp(2.5rem,5vw,5rem);align-items:center}
.split .visual{position:relative}
.split .visual img{border:0;filter:saturate(.72) brightness(.86)}
.split .visual::after{content:"";position:absolute;inset:1rem -1rem -1rem 1rem;border:1px solid rgba(185,161,122,.28);z-index:-1}
.feat{list-style:none;padding:0;margin:1.6rem 0 2.2rem;display:grid;gap:.9rem}
.feat li{display:flex;gap:.9rem;align-items:baseline;color:var(--muted)}
.feat li::before{content:"—";color:var(--gold);flex:none}
.dest-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:1.4rem}
.dest{position:relative;aspect-ratio:4/5;overflow:hidden;display:flex;align-items:flex-end;border:0;background:#141515}
.dest::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,transparent 40%,rgba(7,8,8,.76) 100%);pointer-events:none}
.dest img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform 1.1s var(--ease-lux),filter 1s var(--ease-lux);filter:brightness(.76) saturate(.72)}
.dest:hover img{transform:scale(1.04);filter:brightness(.9) saturate(.88)}
.dest .ov{position:relative;z-index:1;padding:1.5rem;width:100%}
.dest h3{margin:0;font-size:clamp(1.45rem,2.2vw,1.85rem)}
.dest .wx{font:600 .7rem var(--sans);letter-spacing:.14em;text-transform:uppercase;color:var(--gold2)}
.form{display:grid;grid-template-columns:1fr 1fr;gap:1.6rem 1.8rem;margin-top:2.5rem;padding:clamp(1.8rem,4vw,3rem);background:linear-gradient(145deg,rgba(255,255,255,.018),transparent 42%),#101111;border:1px solid var(--line2)}
.form label{position:relative;display:flex;flex-direction:column;gap:.65rem;font:500 .62rem var(--sans);letter-spacing:.18em;text-transform:uppercase;color:var(--muted)}
.form label:not(.check)::after{content:"";position:absolute;left:0;bottom:0;width:100%;height:1px;background:var(--gold2);transform:scaleX(0);transform-origin:left;transition:transform .5s var(--ease-lux)}
.form label:focus-within{color:var(--gold2)}
.form label:focus-within::after{transform:scaleX(1)}
.form input,.form textarea{width:100%;min-height:3.25rem;font:400 .98rem var(--sans);letter-spacing:normal;text-transform:none;padding:.78rem .05rem;background:transparent;border:0;border-bottom:1px solid var(--line);border-radius:0;color:var(--ivory);transition:border-color .4s var(--ease-lux),background .4s}
.form textarea{min-height:7rem;resize:vertical}
.form input:focus,.form textarea:focus{outline:none;border-color:var(--gold)}
.form input::placeholder,.form textarea::placeholder{color:var(--faint)}
.form input:-webkit-autofill,.form input:-webkit-autofill:hover,.form input:-webkit-autofill:focus{-webkit-text-fill-color:var(--ivory);-webkit-box-shadow:0 0 0 1000px #101111 inset;transition:background-color 9999s ease-out}
.form input[type=date],.form input[type=time]{color-scheme:dark}
.form .wide{grid-column:1/-1}
.concierge-form{gap:2rem 1.8rem}
.concierge-progress{grid-column:1/-1;display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:.75rem;padding-bottom:1.35rem;border-bottom:1px solid var(--line2)}
.concierge-progress-step{position:relative;display:flex;flex-direction:column;gap:.45rem;color:var(--faint);font:500 .52rem/1.4 var(--sans);letter-spacing:.14em;text-transform:uppercase}
.concierge-progress-step::before{content:"";height:1px;background:var(--line);transition:background .5s var(--ease-lux)}
.concierge-progress-step.active::before,.concierge-progress-step.complete::before{background:var(--gold2)}
.concierge-progress-step i{font:400 1.15rem/1 var(--serif);font-style:normal;color:var(--faint)}
.concierge-progress-step.active,.concierge-progress-step.complete{color:var(--muted)}
.concierge-progress-step.active i{color:var(--gold2)}
.concierge-step{grid-column:1/-1;min-width:0;margin:0;padding:0;border:0}
.concierge-step[disabled]{display:none}
.concierge-step-heading{margin-bottom:2.1rem}
.concierge-step-heading .eyebrow{margin-bottom:.85rem}
.concierge-step-heading h2{margin:0 0 .55rem;font-size:clamp(2.2rem,4.8vw,3.7rem)}
.concierge-step-heading>p:last-child{margin:0;color:var(--muted);font-size:.92rem}
.concierge-fields{display:grid;grid-template-columns:1fr 1fr;gap:1.5rem 1.8rem}
.concierge-fields .concierge-full{grid-column:1/-1}
.concierge-fields select{width:100%;min-height:3.25rem;padding:.8rem .05rem;border:0;border-bottom:1px solid var(--line);border-radius:0;background:#101111;color:var(--ivory);font:400 .98rem var(--sans);transition:border-color .4s var(--ease-lux)}
.concierge-fields select:focus{outline:none;border-color:var(--gold)}
.concierge-guidance{max-width:46rem;margin:0;padding:1.2rem 0;color:var(--muted);font-size:.92rem}
.concierge-review{padding:1.5rem 0 0;border-top:1px solid var(--line2)}
.concierge-review .eyebrow{margin-bottom:1rem}
.concierge-review dl{display:grid;grid-template-columns:1fr 1fr;gap:1rem 2rem;margin:0}
.concierge-review dl>div{min-width:0}
.concierge-review dt{margin-bottom:.3rem;color:var(--faint);font:500 .57rem var(--sans);letter-spacing:.14em;text-transform:uppercase}
.concierge-review dd{margin:0;color:var(--ivory);font:400 1.05rem var(--serif);overflow-wrap:anywhere}
.concierge-actions{display:flex;align-items:center;justify-content:flex-end;gap:1.4rem}
.concierge-actions .btn{min-width:13rem}
.concierge-step-count{margin-right:auto;color:var(--faint);font:500 .6rem var(--sans);letter-spacing:.16em;text-transform:uppercase}
.concierge-back{padding:.7rem 0;border:0;background:none;color:var(--muted);font:500 .65rem var(--sans);letter-spacing:.14em;text-transform:uppercase;cursor:pointer;transition:color .3s}
.concierge-back:hover{color:var(--ivory)}
.concierge-back:disabled{opacity:.5;cursor:wait}
.concierge-success{max-width:820px;margin:2.5rem auto;padding:clamp(2rem,5vw,4rem);border:1px solid var(--line);background:linear-gradient(140deg,rgba(255,255,255,.025),transparent 65%)}
.concierge-success h2{font-size:clamp(2.4rem,5vw,4rem)}
.concierge-success>p:last-child{max-width:38rem;margin:0;color:var(--muted)}
.visually-hidden{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
.check{flex-direction:row!important;align-items:center;gap:.7rem!important;letter-spacing:0!important;text-transform:none!important;font:400 .95rem var(--sans)!important;color:var(--ivory)!important}
.check input{width:1.05rem;height:1.05rem;accent-color:var(--gold)}
.hp{position:absolute;left:-9999px;width:1px;height:1px;opacity:0}
.notice{padding:1.2rem 1.4rem;border:1px solid rgba(185,161,122,.4);background:rgba(185,161,122,.055);margin-top:2rem}
.notice.err{border-color:#A33;background:rgba(170,51,51,.08)}
.pagehero{position:relative;overflow:hidden;padding:clamp(10rem,17vh,13rem) 0 4.5rem;border-bottom:1px solid var(--line2);background:radial-gradient(70% 100% at 80% 0%,rgba(185,161,122,.08),transparent 65%),linear-gradient(180deg,#0c0d0d,#090a0b)}
.pagehero h1{max-width:14ch;font-size:clamp(3.2rem,7vw,6.5rem);letter-spacing:-.025em}
.pagehero .lead{max-width:39rem}
.quoteblock{max-width:52rem;margin:0 auto;text-align:center}
.quoteblock blockquote{font:italic 400 clamp(1.4rem,2.6vw,2rem)/1.45 var(--serif);margin:0 0 1.4rem}
.quoteblock blockquote::before{content:"“";color:var(--gold);margin-right:.15em}
.quoteblock cite{font:600 .72rem var(--sans);letter-spacing:.28em;text-transform:uppercase;color:var(--muted);font-style:normal}
.faq{max-width:52rem;margin:0 auto}
.faq details{border-bottom:1px solid var(--line2)}
.faq summary{cursor:pointer;list-style:none;display:flex;justify-content:space-between;align-items:center;gap:1rem;padding:1.5rem .2rem;font:500 1.2rem var(--serif)}
.faq summary::-webkit-details-marker{display:none}
.faq summary::after{content:"+";color:var(--gold);font-size:1.5rem;transition:transform .3s}
.faq details[open] summary::after{transform:rotate(45deg)}
.faq details[open] summary{color:var(--gold2)}
.faq details p{color:var(--muted);padding:0 .2rem 1.5rem;max-width:44rem}
.map{height:min(68vh,600px);min-height:360px;margin:3rem 0;border:1px solid var(--line2);background:#111312;filter:none;isolation:isolate}
.map.leaflet-container{height:100%;background:#111312;font:400 .8rem var(--sans)}
.map .luxury-map-tiles{filter:invert(.88) hue-rotate(180deg) grayscale(.78) brightness(.72) contrast(.88)}
.map.leaflet-container .leaflet-control-attribution{background:rgba(9,10,11,.82);color:#929087}
.map .leaflet-control-attribution a{color:var(--gold2)}
.map .leaflet-bar a{background:#111312;color:var(--ivory);border-color:var(--line)}
.map .leaflet-bar a:hover{background:#20211f;color:var(--gold2)}
.map .leaflet-tooltip{background:#111312;color:var(--ivory);border:1px solid var(--line);border-radius:0;box-shadow:none}
.map .leaflet-tooltip::before{border-right-color:var(--line)}
.map .route-line{stroke-dasharray:2 10;stroke-dashoffset:90;opacity:0}
.map.routes-visible .route-line{animation:route-draw 1.8s .15s var(--ease-lux) both}
@keyframes route-draw{from{stroke-dashoffset:90;opacity:0}to{stroke-dashoffset:0;opacity:.72}}
.sample{font:500 .62rem var(--sans);letter-spacing:.1em;text-transform:uppercase;color:var(--gold-d)}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:1.6rem}
.foot{background:#080909;border-top:1px solid var(--line2)}
.foot .cols{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:2.5rem;padding:4.5rem 0 3rem}
.foot h4{font:500 .62rem var(--sans);letter-spacing:.24em;text-transform:uppercase;color:var(--gold2);margin:0 0 1.2rem}
.foot ul{list-style:none;margin:0;padding:0;display:grid;gap:.6rem}
.foot ul a{color:var(--muted);font-size:.92rem} .foot ul a:hover{color:var(--ivory)}
.foot .note{color:var(--faint);font-size:.82rem;max-width:30rem;margin-top:1rem}
.foot .bar{border-top:1px solid var(--line2);padding:1.4rem 0;color:var(--faint);font-size:.78rem;display:flex;justify-content:space-between;gap:1rem;flex-wrap:wrap}
.photo-credit{margin:0 0 1.4rem;color:var(--faint);font-size:.72rem}
.photo-credit a{color:var(--muted);text-decoration:underline;text-underline-offset:3px}
.photo-credit a:hover{color:var(--gold2)}
.rv,.reveal{opacity:1;transform:none;transition:opacity .9s var(--ease-lux),transform .9s var(--ease-lux)}
.motion-ready .rv:not(.in),.motion-ready .reveal:not(.in){opacity:0;transform:translate3d(0,28px,0)}
.motion-ready .reveal--left:not(.in){transform:translate3d(-48px,0,0)}
.motion-ready .reveal--right:not(.in){transform:translate3d(48px,0,0)}
.motion-ready .reveal--image:not(.in){opacity:1;transform:none}
.reveal--image .visual img{transition:clip-path 1.15s var(--ease-lux),transform 1.5s var(--ease-lux);clip-path:inset(0 0 0 0);transform:scale(1.06)}
.motion-ready .reveal--image:not(.in) .visual img{clip-path:inset(0 0 100% 0);transform:scale(1.1)}
.reveal--image.in .visual img{transform:scale(1)}
.ac .ph{clip-path:inset(0)}
.ac .ph img,.dest img{transition:transform 1s var(--ease-lux),clip-path 1.1s var(--ease-lux);clip-path:inset(0)}
.motion-ready .ac.rv:not(.in) .ph,.motion-ready .dest.rv:not(.in) img{clip-path:inset(100% 0 0 0)}
.motion-ready .fleet-grid>.rv:not(.in){transform:translate3d(36px,0,0)}
.motion-ready .fleet-grid>.rv:nth-child(even):not(.in){transform:translate3d(-36px,0,0)}
.motion-ready .dest-grid>.rv:not(.in){transform:translate3d(0,24px,0)}
.fleet-grid>.rv:nth-child(2){transition-delay:.1s}.fleet-grid>.rv:nth-child(3){transition-delay:.2s}
.dest-grid>.rv:nth-child(2){transition-delay:.08s}.dest-grid>.rv:nth-child(3){transition-delay:.16s}.dest-grid>.rv:nth-child(4){transition-delay:.24s}
.steps>.rv:nth-child(2){transition-delay:.1s}.steps>.rv:nth-child(3){transition-delay:.2s}.steps>.rv:nth-child(4){transition-delay:.3s}
.rv.in,.reveal.in{opacity:1;transform:none}
@supports (animation-timeline:view()){
  .visual img,.ac .ph img,.dest img{animation:image-scroll-drift linear both;animation-timeline:view();animation-range:cover 0% cover 100%}
  @keyframes image-scroll-drift{from{object-position:center 45%}to{object-position:center 55%}}
}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.rv,.reveal{opacity:1;transform:none;transition:none}.motion-ready .rv:not(.in),.motion-ready .reveal:not(.in){opacity:1;transform:none}.reveal--image .visual img,.ac .ph img,.dest img{clip-path:none!important;transform:none!important;animation:none!important}*,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;scroll-behavior:auto!important;transition-duration:.01ms!important}}
@media(prefers-reduced-motion:reduce){.map .route-line{stroke-dashoffset:0;opacity:.72;animation:none}}
@media(max-width:900px){
  .split{grid-template-columns:1fr;gap:3.5rem}
  .foot .cols{grid-template-columns:1fr 1fr}
  .hero-intro{padding-top:clamp(9.5rem,18vh,12rem)}
  .hero-intro h1{font-size:clamp(3.7rem,9vw,6rem)}
  .journey-layout{grid-template-columns:minmax(240px,.85fr) minmax(0,1.15fr);gap:2.5rem}
  .journey-scene{min-height:70svh}
  .journey-visual{height:65vh}
}
@media(max-width:640px){
  .form{grid-template-columns:1fr}
  .top,.top.scrolled{padding:.8rem 1.1rem}
  .brand{font-size:1.4rem}
  .brand-mark{width:2.25rem;height:2.25rem}
  .menu-toggle{width:2.8rem;height:2.8rem;display:flex;flex-direction:column;justify-content:center;align-items:center;gap:5px;border:1px solid var(--line);border-radius:0;background:rgba(9,10,11,.16);color:var(--ivory);cursor:pointer;z-index:2}
  .menu-toggle span{width:15px;height:1px;background:currentColor;transition:transform .4s var(--ease-lux),opacity .3s}
  .menu-toggle.active span:first-child{transform:translateY(6px) rotate(45deg)}
  .menu-toggle.active span:nth-child(2){opacity:0}
  .menu-toggle.active span:last-child{transform:translateY(-6px) rotate(-45deg)}
  .site-nav{position:absolute;inset:100% 0 auto;display:flex;align-items:stretch;flex-direction:column;gap:0;padding:.75rem 1.25rem 1.25rem;background:rgba(9,10,11,.97);border-bottom:1px solid var(--line);backdrop-filter:blur(18px);opacity:0;visibility:hidden;transform:translateY(-8px);pointer-events:none;transition:opacity .45s var(--ease-lux),transform .45s var(--ease-lux),visibility .45s}
  .site-nav.open{opacity:1;visibility:visible;transform:none;pointer-events:auto}
  .site-nav>a:not(.btn){display:block;padding:1rem 0;border-bottom:1px solid var(--line2);font-size:.72rem}
  .site-nav>a:not(.btn)::after{display:none}
  .site-nav .lang{align-self:flex-start;margin:1rem 0}
  .site-nav .btn{align-self:stretch;justify-content:center}
  .hero-intro{inset:0;padding-top:clamp(9rem,18vh,10.5rem)}
  .hero-intro h1{max-width:11ch;font-size:clamp(3.25rem,13vw,4.8rem);line-height:.96}
  .hero-intro .lead{font-size:.91rem;max-width:28rem;line-height:1.65}
  .hero-stage{min-height:100svh}
  .hero .bgimg img{object-position:57% center}
  .hero .veil{background:radial-gradient(ellipse at 58% 46%,transparent 16%,rgba(0,0,0,.3) 100%),linear-gradient(180deg,rgba(5,7,9,.16) 0%,rgba(5,7,9,.16) 36%,rgba(5,7,9,.82) 100%),linear-gradient(90deg,rgba(5,7,9,.5),rgba(5,7,9,.12) 100%)}
  .hero-stage-content{left:1.25rem;right:1.25rem;bottom:3.7rem}
  .hero .cta{justify-content:flex-start;gap:.65rem}
  .hero .cta .btn{min-width:min(15rem,88vw);min-height:3.4rem}
  .hero .cta .btn.ghost{display:none}
  .scroll-cue{left:auto;right:1.25rem;bottom:1.25rem;transform:none}
  .scroll-cue span{height:18px}
  .stats .wrap{grid-template-columns:1fr 1fr}
  .stat{padding:1.5rem .6rem}
  .sec{padding:5rem 0}
  .sec.head{margin-bottom:2.2rem}
  .journey{padding:4rem 0 2rem}
  .journey-heading{align-items:flex-start;flex-direction:column;gap:.8rem;margin-bottom:1.5rem}
  .journey-heading>p:last-child{font-size:.84rem}
  .journey-layout{display:block;padding:0 1.1rem}
  .journey-copy{display:block}
  .journey-scene{min-height:0;padding:2rem 0 3.25rem;opacity:1}
  .journey-scene:not(:first-child){margin-top:1rem}
  .journey-scene-image{position:relative;display:block;height:clamp(14rem,66vw,21rem);margin:0 0 1.7rem;overflow:hidden;background:#171817}
  .journey-scene-image img{width:100%;height:100%;object-fit:cover;filter:saturate(.72) brightness(.78)}
  .journey-scene h2{max-width:13ch;font-size:clamp(2.45rem,10.5vw,3.6rem)}
  .journey-scene--invitation .btn{min-height:3.2rem}
  .journey-visual{display:none}
  .fleet-grid{grid-template-columns:1fr;gap:1.2rem}
  .fleet-showcase .ac{grid-template-columns:1fr}
  .fleet-showcase .ac:nth-child(even) .ph,.fleet-showcase .ac:nth-child(even) .bd{grid-column:1;grid-row:auto}
  .fleet-showcase .ac .ph{min-height:0;aspect-ratio:4/3}
  .fleet-showcase .ac .bd{padding:1.5rem}
  .dest-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:.7rem}
  .dest{aspect-ratio:3/4}
  .dest .ov{padding:.9rem}
  .dest h3{font-size:1.3rem}
  .form{gap:1.3rem;padding:1.25rem}
  .concierge-form{gap:1.5rem;padding:1.25rem}
  .concierge-progress{gap:.32rem;padding-bottom:1rem}
  .concierge-progress-step{font-size:0;gap:.4rem;align-items:flex-start}
  .concierge-progress-step i{font-size:1rem}
  .concierge-step-heading{margin-bottom:1.6rem}
  .concierge-step-heading h2{font-size:clamp(2rem,8.8vw,2.8rem)}
  .concierge-fields{grid-template-columns:1fr;gap:1.25rem}
  .concierge-fields .concierge-full{grid-column:auto}
  .concierge-review dl{grid-template-columns:1fr;gap:.8rem}
  .concierge-actions{flex-wrap:wrap;gap:.7rem 1rem}
  .concierge-actions .btn{width:100%;min-height:3.3rem}
  .concierge-step-count{order:-1;width:100%}
  .concierge-success{margin:1.5rem 0;padding:1.5rem}
  .concierge-success h2{font-size:2.6rem}
  .pagehero{padding:9.5rem 0 3.5rem}
  .pagehero h1{font-size:clamp(3rem,13vw,4.8rem)}
  .map{height:55svh;min-height:320px}
  .split .visual::after{inset:.7rem -.7rem -.7rem .7rem}
  .hero .bgimg img,.visual img,.ac .ph img,.dest img{animation:none}
  .motion-ready .reveal--left:not(.in),.motion-ready .reveal--right:not(.in){transform:translate3d(0,20px,0)}
  .stats .wrap{grid-template-columns:1fr 1fr}
  .stat{padding:1.4rem .6rem;border-left:0;border-top:1px solid var(--line2)}
  .stat:nth-child(-n+2){border-top:0}
  .foot .cols{grid-template-columns:1fr;gap:1.8rem}
}

.admin-shell{min-height:100svh;background:radial-gradient(70% 50% at 100% 0%,rgba(198,161,91,.08),transparent 60%),var(--bg)}
.admin-top{position:sticky;top:0;z-index:20;display:flex;justify-content:space-between;align-items:center;gap:1rem;padding:.85rem clamp(1rem,4vw,3rem);background:rgba(5,7,9,.92);backdrop-filter:blur(16px);border-bottom:1px solid var(--line2)}
.admin-user{display:flex;align-items:center;gap:1.2rem;color:var(--muted);font-size:.8rem}
.admin-user a{color:var(--gold2);font-size:.75rem;letter-spacing:.1em;text-transform:uppercase}
.admin-main{max-width:1180px;margin:0 auto;padding:clamp(2.5rem,6vw,5rem) clamp(1rem,4vw,2.5rem)}
.admin-heading{display:flex;justify-content:space-between;align-items:flex-end;gap:2rem;margin-bottom:2.4rem}
.admin-heading h1{font-size:clamp(2.5rem,5vw,4rem);margin-bottom:.4rem}
.admin-heading p:not(.eyebrow){color:var(--muted);margin:0}
.admin-heading .btn{white-space:nowrap}
.admin-tabs{display:flex;gap:.4rem;overflow-x:auto;border-bottom:1px solid var(--line);margin-bottom:1.5rem}
.admin-tabs button{position:relative;flex:none;border:0;border-bottom:2px solid transparent;padding:1rem 1rem .9rem;background:none;color:var(--muted);font:600 .72rem var(--sans);letter-spacing:.12em;text-transform:uppercase;cursor:pointer}
.admin-tabs button:hover,.admin-tabs button.active{color:var(--ivory)}
.admin-tabs button.active{border-bottom-color:var(--gold)}
.admin-badge{display:inline-grid;place-items:center;min-width:1.2rem;height:1.2rem;margin-left:.55rem;padding:0 .3rem;border-radius:1rem;background:var(--gold);color:#14100a;font-size:.65rem}
.admin-panel{padding:clamp(1.1rem,3vw,2rem);border:1px solid var(--line2);background:rgba(18,22,31,.85)}
.admin-panel-heading{display:flex;justify-content:space-between;align-items:center;gap:1.5rem;margin-bottom:1.5rem}
.admin-panel-heading h2{font-size:1.8rem;margin:0 0 .25rem}
.admin-panel-heading p{color:var(--muted);font-size:.9rem;margin:0}
.admin-locale{display:flex;align-items:center;gap:.7rem;color:var(--muted);font-size:.72rem;letter-spacing:.12em;text-transform:uppercase}
.admin-locale select,.admin-table select{border:1px solid var(--line);background:var(--bg);color:var(--ivory);padding:.65rem .8rem;font:500 .85rem var(--sans)}
.admin-form{display:grid;grid-template-columns:1fr 1fr;gap:1.2rem 1.4rem;padding:0;margin:0;background:none;border:0}
.admin-form h3{grid-column:1/-1;font-size:1.4rem;margin:0}
.admin-form>label,.admin-two>label,.admin-four>label{display:flex;flex-direction:column;gap:.45rem;color:var(--muted);font:600 .67rem var(--sans);letter-spacing:.15em;text-transform:uppercase}
.admin-form input:not([type=checkbox]):not([type=file]),.admin-form textarea{width:100%;border:1px solid var(--line);background:#090c11;color:var(--ivory);padding:.85rem .95rem;font:400 .95rem/1.55 var(--sans);text-transform:none;letter-spacing:normal;resize:vertical}
.admin-form input:focus,.admin-form textarea:focus,.admin-table select:focus{outline:none;border-color:var(--gold)}
.admin-form input[type=file]{color:var(--muted);font:400 .8rem var(--sans);letter-spacing:normal;text-transform:none}
.admin-form small{font:400 .72rem var(--sans);letter-spacing:normal;text-transform:none;overflow-wrap:anywhere}
.admin-submit{grid-column:1/-1;justify-self:start;min-width:12rem;justify-content:center}
.admin-copy-group{grid-column:1/-1;border:1px solid var(--line2);background:rgba(10,13,18,.4)}
.admin-copy-group summary{display:flex;justify-content:space-between;align-items:center;gap:1rem;padding:1rem 1.1rem;color:var(--ivory);font:500 1rem var(--serif);cursor:pointer;list-style:none}
.admin-copy-group summary::-webkit-details-marker{display:none}
.admin-copy-group summary::after{content:"+";color:var(--gold);font:400 1.2rem var(--sans)}
.admin-copy-group[open] summary::after{content:"−"}
.admin-copy-group summary span{margin-left:auto;color:var(--faint);font:600 .6rem var(--sans);letter-spacing:.1em;text-transform:uppercase}
.admin-copy-fields{display:grid;grid-template-columns:1fr 1fr;gap:1rem;padding:0 1.1rem 1.1rem}
.admin-editor{margin-top:2rem;padding-top:1.8rem;border-top:1px solid var(--line)}
.admin-two{grid-column:1/-1;display:grid;grid-template-columns:1fr 1fr;gap:1.2rem}
.admin-four{grid-column:1/-1;display:grid;grid-template-columns:repeat(4,1fr);gap:1rem}
.admin-check{grid-column:1/-1;display:flex;align-items:center;gap:.65rem;color:var(--ivory);font-size:.86rem}
.admin-check input{width:1.1rem;height:1.1rem;accent-color:var(--gold)}
.admin-form-actions{grid-column:1/-1;display:flex;align-items:center;gap:1rem}
.admin-card-list{display:grid;gap:.6rem}
.admin-item{display:flex;justify-content:space-between;align-items:center;gap:1rem;padding:1rem 1.1rem;border:1px solid var(--line2);background:rgba(10,13,18,.64)}
.admin-item h3{font-size:1.2rem;margin:.25rem 0}
.admin-item h3 small{font:400 .78rem var(--sans);color:var(--muted)}
.admin-item p{margin:0;color:var(--muted);font-size:.78rem}
.admin-state{display:inline-flex;padding:.2rem .45rem;border:1px solid var(--line);color:var(--muted);font:600 .58rem var(--sans);letter-spacing:.12em;text-transform:uppercase}
.admin-state.published{border-color:rgba(132,190,151,.35);color:#9ac8a8}
.admin-item-actions{display:flex;gap:1rem}
.admin-link{border:0;background:none;color:var(--gold2);font:600 .72rem var(--sans);letter-spacing:.12em;text-transform:uppercase;cursor:pointer}
.admin-link:hover{text-decoration:underline;text-underline-offset:4px}
.admin-link.danger{color:#e5968a}
.admin-link:disabled{opacity:.5;cursor:wait}
.admin-count{color:var(--muted);font-size:.78rem}
.admin-table-wrap{overflow-x:auto}
.admin-table{width:100%;border-collapse:collapse;text-align:left}
.admin-table th{padding:.8rem .7rem;color:var(--faint);font:600 .62rem var(--sans);letter-spacing:.14em;text-transform:uppercase}
.admin-table td{padding:1rem .7rem;border-top:1px solid var(--line2);vertical-align:top;font-size:.82rem}
.admin-table td strong{font-size:.74rem;color:var(--gold2)}
.admin-table td small{display:block;margin-top:.3rem;color:var(--muted);font-size:.72rem}
.admin-table td p{max-width:18rem;margin:.5rem 0 0;color:var(--muted);font-size:.75rem;white-space:pre-wrap}
.admin-table td a:hover{color:var(--gold2)}
.admin-table select{min-width:7rem;padding:.55rem;font-size:.75rem;text-transform:capitalize}
.admin-workflow-row>td{padding:0 1rem 1.2rem!important;background:rgba(8,10,14,.38)}
.admin-workflow-actions{display:grid;gap:.65rem;margin-top:.55rem}
.admin-workflow-actions label{display:grid;gap:.35rem;color:var(--muted);font-size:.68rem;letter-spacing:.08em;text-transform:uppercase}
.admin-workflow-actions select,.admin-workflow-actions textarea{width:100%;border:1px solid var(--line);background:var(--bg);color:var(--ivory);padding:.6rem;font:400 .8rem var(--sans);text-transform:none;letter-spacing:normal}
.admin-workflow-actions textarea{min-height:4rem;resize:vertical}
.admin-workflow-details{margin:.6rem 0;border-top:1px solid var(--line2);padding-top:.6rem}
.admin-workflow-details summary{color:var(--ivory);font-size:.8rem;cursor:pointer}
.admin-workflow-details ol{display:grid;gap:.5rem;padding-left:1.3rem;color:var(--muted);font-size:.75rem}
.admin-workflow-details li strong,.admin-workflow-details li span{display:block}
.admin-workflow-details li p{max-width:none!important}
.admin-workflow-form{margin:1rem 0;padding:1rem;border:1px solid var(--line2)}
.admin-workflow-form>p{grid-column:1/-1;color:var(--muted);font-size:.8rem}
.quote-response{max-width:58rem}
.quote-response h1{max-width:16ch}
.admin-alert{padding:.9rem 1rem;margin:0 0 1rem;border:1px solid;font-size:.86rem}
.admin-alert.error{border-color:rgba(211,106,96,.5);background:rgba(170,51,51,.1);color:#f1b6ae}
.admin-alert.success{border-color:rgba(132,190,151,.35);background:rgba(132,190,151,.07);color:#b1d7bb}
.admin-empty{padding:2rem;text-align:center;color:var(--muted)}
.admin-gate{min-height:100svh;display:grid;place-items:center;padding:1.5rem;background:radial-gradient(70% 60% at 80% 10%,rgba(198,161,91,.1),transparent 65%),var(--bg)}
.admin-gate-card{max-width:36rem;padding:clamp(2rem,5vw,3rem);border:1px solid var(--line);background:var(--panel);text-align:center}
.admin-gate-card .brand-mark{margin:0 auto 1.7rem}
.admin-gate-card .eyebrow{justify-content:center}
.admin-gate-card h1{font-size:2.5rem}
.admin-gate-card>p:not(.eyebrow){color:var(--muted);margin-bottom:1.6rem}
.place-card{overflow:hidden;border:1px solid var(--line2);background:#111212;transition:border-color .5s var(--ease-lux),transform .6s var(--ease-lux)}
.place-card:hover{border-color:rgba(185,161,122,.42);transform:translateY(-3px)}
.place-image{aspect-ratio:4/3;overflow:hidden;background:#171817}
.place-image img{width:100%;height:100%;object-fit:cover;filter:saturate(.72) brightness(.84);transition:transform 1s var(--ease-lux),filter 1s var(--ease-lux)}
.place-card:hover .place-image img{transform:scale(1.035);filter:saturate(.88) brightness(.96)}
.place-body{padding:1.4rem 1.5rem 1.6rem}
.place-body h2{font-size:clamp(1.6rem,2.5vw,2rem)}
.place-body p{color:var(--muted);font-size:.9rem}
@media(max-width:760px){
  .admin-main{padding-top:2rem}
  .admin-heading{align-items:flex-start;flex-direction:column}
  .admin-panel-heading{align-items:flex-start;flex-direction:column}
  .admin-four{grid-template-columns:1fr 1fr}
  .admin-table{min-width:760px}
}
@media(max-width:520px){
  .admin-user span{max-width:9rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .admin-form,.admin-two{grid-template-columns:1fr}
  .admin-copy-fields{grid-template-columns:1fr}
  .admin-four{grid-template-columns:1fr 1fr}
  .admin-item{align-items:flex-start;flex-direction:column}
  .admin-panel{padding:1rem}
}

.admin-shell{overflow-x:clip}
.admin-main{width:100%;min-width:0}
.admin-panel,.admin-form,.admin-item,.admin-copy-group{min-width:0}
.admin-language select{min-height:44px;border:1px solid var(--line);background:var(--bg);color:var(--ivory);padding:.5rem .7rem;font:600 .8rem var(--sans)}
.admin-form select{width:100%;min-height:44px;border:1px solid var(--line);background:#090c11;color:var(--ivory);padding:.75rem .85rem;font:400 .95rem var(--sans)}
.admin-form input:not([type=checkbox]):not([type=file]),.admin-form textarea{min-height:46px}
.admin-form textarea{min-height:7rem}
.admin-form input:focus-visible,.admin-form textarea:focus-visible,.admin-form select:focus-visible,.admin-language select:focus-visible,.admin-tabs button:focus-visible,.admin-shell button:focus-visible,.image-picker-preview:focus-visible{outline:2px solid var(--gold2);outline-offset:3px}
.admin-tabs{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));overflow:visible}
.admin-tabs button{min-width:0;min-height:48px;padding:.75rem .5rem;letter-spacing:.05em;white-space:normal}
.admin-copy-group summary{min-height:56px}
.cms-field-list{display:grid;gap:.7rem;padding:0 1rem 1rem}
.cms-field-pair{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.7rem 1rem;margin:0;padding:1rem;border:1px solid var(--line2);min-width:0}
.cms-field-pair legend{grid-column:1/-1;padding:0;color:var(--ivory);font:500 1rem var(--serif)}
.cms-field-pair>label{display:flex;min-width:0;flex-direction:column;gap:.4rem;color:var(--muted);font:600 .7rem var(--sans)}
.cms-field-pair input,.cms-field-pair textarea{width:100%;min-width:0;border:1px solid var(--line);background:#090c11;color:var(--ivory);padding:.75rem;font:400 .9rem/1.5 var(--sans)}
.cms-field-pair input::placeholder,.cms-field-pair textarea::placeholder{color:#85837f;opacity:1}
.cms-reset{align-self:flex-start;min-height:44px}
.admin-save-bar{position:sticky;bottom:0;z-index:10;grid-column:1/-1;display:flex;justify-content:space-between;align-items:center;gap:1rem;padding:1rem;border:1px solid var(--line);background:rgba(7,9,13,.96);backdrop-filter:blur(12px)}
.admin-save-bar span{color:var(--gold2);font-size:.85rem}
.admin-submit{min-height:48px}
.photo-slot-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,220px),1fr));gap:1rem}
.photo-slot-card{display:grid;gap:.65rem;min-width:0;padding:.65rem;border:1px solid var(--line2);background:#0b0e12;color:var(--ivory);text-align:left;cursor:pointer}
.photo-slot-card:hover{border-color:var(--gold)}
.photo-slot-card:focus-visible{outline:2px solid var(--gold2);outline-offset:3px}
.photo-slot-card strong{font:500 1.15rem var(--serif)}
.photo-slot-card>span:last-child,.image-picker-help{color:var(--muted);font-size:.75rem}
.photo-slot-thumb{display:block;aspect-ratio:16/9;overflow:hidden;background:#171a20}
.photo-slot-thumb img{width:100%;height:100%;object-fit:cover}
.photo-editor{grid-template-columns:minmax(0,1fr)}
.image-picker{display:grid;gap:.65rem;min-width:0}
.image-picker-preview{position:relative;display:grid;width:100%;aspect-ratio:4/3;place-items:center;overflow:hidden;border:1px solid var(--line);background:#090c11;color:var(--ivory);cursor:crosshair}
.image-picker-preview.wide{aspect-ratio:16/9}
.image-picker-preview img{width:100%;height:100%;object-fit:cover}
.image-picker-preview i{position:absolute;width:18px;height:18px;border:2px solid white;border-radius:50%;box-shadow:0 0 0 1px #000;transform:translate(-50%,-50%);pointer-events:none}
.image-picker-button{min-height:46px;justify-self:start}
.image-picker-alt{grid-template-columns:repeat(2,minmax(0,1fr))}
.image-picker-warning,.admin-review-note{padding:.65rem .8rem;border-left:2px solid var(--gold);background:rgba(198,161,91,.08);color:#e7d8b9;font-size:.82rem}
.admin-history{min-width:0}
.admin-history-list{display:grid;gap:.55rem;margin-top:.5rem}
.admin-history-list article{display:grid;gap:.3rem;padding:.7rem;border:1px solid var(--line2);color:var(--muted);font-size:.76rem}
.admin-history-list article strong{color:var(--ivory)}
.admin-history-list .admin-link,.admin-link,.admin-item-actions button{min-height:44px;padding:.55rem .65rem}
.admin-item-actions{flex-wrap:wrap;align-items:center;gap:.25rem}
.admin-alert a{display:inline-block;min-height:44px;padding:.6rem .4rem;color:var(--ivory);text-underline-offset:4px}
.price-suggestion{border-left:2px solid var(--gold);padding:.7rem;color:var(--gold2)!important}
.pricing-list{display:grid;gap:.7rem}
.pricing-item{display:flex;justify-content:space-between;gap:1.5rem;align-items:center;padding:1rem 0;border-bottom:1px solid var(--line2)}
.pricing-item h3{margin:0;font:500 1.5rem var(--serif)}
.pricing-item p{margin:.35rem 0 0;color:var(--muted)}
.pricing-item strong{white-space:nowrap;color:var(--gold2)}
.destination-price{display:grid;gap:.2rem}
.destination-price span{color:var(--muted);font-size:.8rem}
.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}

@media(max-width:760px){
  .admin-tabs{grid-template-columns:repeat(3,minmax(0,1fr))}
  .admin-tabs button{font-size:.68rem}
  .admin-table{min-width:0!important}
  .admin-table thead{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}
  .admin-table,.admin-table tbody{display:block;width:100%}
  .admin-table tbody tr:not(.admin-workflow-row){display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);margin:.7rem 0;border:1px solid var(--line2);background:rgba(10,13,18,.5)}
  .admin-table tbody tr:not(.admin-workflow-row)>td{min-width:0;padding:.75rem .55rem;border:0;overflow-wrap:anywhere}
  .admin-table tbody tr:not(.admin-workflow-row)>td:first-child,.admin-table tbody tr:not(.admin-workflow-row)>td:last-child{grid-column:1/-1}
  .admin-table .admin-workflow-row{display:block}
  .admin-table .admin-workflow-row>td{display:block;padding:.7rem!important;overflow-wrap:anywhere}
  .admin-table-wrap{overflow:visible}
}
@media(max-width:520px){
  .admin-main{padding:1.5rem .8rem}
  .admin-heading{gap:1rem;margin-bottom:1.2rem}
  .admin-heading h1{font-size:2.2rem}
  .admin-heading .btn{width:100%;justify-content:center}
  .admin-top{flex-wrap:wrap;padding:.65rem .8rem}
  .admin-user{max-width:100%;gap:.4rem}
  .admin-user span{max-width:7.5rem}
  .admin-user a{padding:.6rem .4rem}
  .admin-panel{padding:.85rem}
  .admin-form,.admin-two,.admin-four,.image-picker-alt{grid-template-columns:minmax(0,1fr)}
  .cms-field-pair{grid-template-columns:minmax(0,1fr);padding:.75rem}
  .cms-field-pair legend{grid-column:1}
  .admin-copy-group summary{padding:.8rem}
  .admin-save-bar{align-items:stretch;flex-direction:column}
  .admin-save-bar .btn{width:100%;justify-content:center}
  .admin-form-actions{align-items:stretch;flex-direction:column}
  .admin-form-actions>*{width:100%;min-height:44px;justify-content:center}
  .admin-item{align-items:stretch}
  .admin-item-actions{width:100%;justify-content:flex-start}
  .admin-item-actions>*{min-width:44px}
  .photo-slot-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
  .photo-slot-card{padding:.45rem}
  .photo-slot-card strong{font-size:1rem;overflow-wrap:anywhere}
  .photo-slot-card>span:last-child{font-size:.65rem}
  .pricing-item{align-items:flex-start;flex-direction:column;gap:.4rem}
  .pricing-item strong{white-space:normal}
