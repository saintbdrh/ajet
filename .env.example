# Quote notifications (Worker secrets in production)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
RESEND_API_KEY=
QUOTE_FROM_EMAIL=
QUOTE_TO_EMAIL=
# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
