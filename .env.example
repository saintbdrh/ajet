# Postgres. Local: `npm run db:up` (Docker). Production: Neon or VPS connection string
DATABASE_URL=postgres://ajet:ajet@localhost:5433/ajet
# File storage (S3 API). Local: RustFS in Docker. Production: Cloudflare R2
# R2: S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com, S3_REGION=auto, R2 API token keys,
# NEXT_PUBLIC_MEDIA_BASE_URL = bucket public URL (custom domain or r2.dev), no trailing slash
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=ajet-media
S3_ACCESS_KEY_ID=ajet
S3_SECRET_ACCESS_KEY=ajet-secret
NEXT_PUBLIC_MEDIA_BASE_URL=http://localhost:9000/ajet-media
# Brand (client name)
NEXT_PUBLIC_BRAND=Ajet
# Weather (OpenWeather). Empty = weather widget hidden
OPENWEATHER_API_KEY=
# Map tiles. Default is the public OSM server: dev only, use a commercial tile provider in production
NEXT_PUBLIC_TILE_URL=
NEXT_PUBLIC_TILE_ATTRIBUTION=
# Quote notifications (Worker secrets in production)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
RESEND_API_KEY=
QUOTE_FROM_EMAIL=
QUOTE_TO_EMAIL=
# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
